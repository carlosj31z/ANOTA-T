{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "rm -rf /*": "deny"
    },
    "external_directory": "allow"
  }
}